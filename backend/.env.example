NODE_ENV=development
PORT=3100

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=vpn_bot

# Telegram
BOT_TOKEN=your_bot_token_from_botfather
MINI_APP_URL=https://vpn.yourdomain.com
WEBHOOK_DOMAIN=https://api.yourdomain.com
WEBHOOK_SECRET=random-string-for-webhook-verification

# 3X-UI Panel
XUI_HOST=your_vps_ip
XUI_PORT=2096
XUI_USERNAME=admin
XUI_PASSWORD=admin
XUI_INBOUND_ID=1

# YooKassa (optional)
YOKASSA_SHOP_ID=
YOKASSA_SECRET_KEY=
YOKASSA_RETURN_URL=

# Admin panel (REQUIRED)
ADMIN_PASSWORD=your-strong-admin-password
JWT_SECRET=your-jwt-secret-min-16-chars
ADMIN_APP_URL=https://admin.yourdomain.com

# Referral
REFERRAL_BONUS_DAYS=3
